configure_interfaces() {
    :
    # Configure interfaces
    # See http://bugs.debian.org/cgi-bin/bugreport.cgi?bug=429689
    # this ensures that secondary ip address is "promoted" to primary
    # when primary address is deleted, instead of deleting both
    # primary and secondary addresses. It looks like this is only
    # available starting from Linux 2.6.16 
    test -f /proc/sys/net/ipv4/conf/all/promote_secondaries && \
        echo 1 >  /proc/sys/net/ipv4/conf/all/promote_secondaries
    update_addresses_of_interface "eth0 192.0.2.1/24 192.0.2.100/24 192.0.2.101/24" ""
    update_addresses_of_interface "lo 127.0.0.1/8" ""
}

script_body() {
    fwb_nft_begin_transaction || exit 1
cat >> "$FWB_NFT_TXN" <<FWB_NFT_RULESET


# ================ IPv4




add table ip filter
add chain ip filter INPUT { type filter hook input priority 0; policy drop; }
add chain ip filter OUTPUT { type filter hook output priority 0; policy drop; }
add chain ip filter FORWARD { type filter hook forward priority 0; policy drop; }
# ================ Table 'filter', automatic rules
add rule ip filter INPUT ct state { established, related } accept
add rule ip filter OUTPUT ct state { established, related } accept
add rule ip filter FORWARD ct state { established, related } accept
# ================ Table 'filter', rule set Policy
# 
# Rule 0 (global)
# 
# Rule 0 (global)
# 
add rule ip filter OUTPUT ip protocol tcp tcp dport 80  ct state { new }  accept
add rule ip filter INPUT ip protocol tcp tcp dport 80  ct state { new }  accept
add rule ip filter FORWARD ip protocol tcp tcp dport 80  ct state { new }  accept
# 
# Rule 1 (global)
# 
# Rule 1 (global)
# 
add rule ip filter OUTPUT  drop
add rule ip filter INPUT  drop
add rule ip filter FORWARD  drop
#



add table ip nat
# Standard NAT chains are considered pre-existing by NATCompiler_nft.
# The hook priorities are the native dstnat (-100) and srcnat (100).
add chain ip nat PREROUTING { type nat hook prerouting priority -100; policy accept; }
add chain ip nat INPUT { type nat hook input priority 100; policy accept; }
add chain ip nat OUTPUT { type nat hook output priority -100; policy accept; }
add chain ip nat POSTROUTING { type nat hook postrouting priority 100; policy accept; }
# ================ Table 'nat',  rule set NAT
# 
# Rule 0 (NAT)
# 
# Rule 0 (NAT)
# 
add rule ip nat POSTROUTING oifname "eth*"  ip saddr 192.168.1.0/24  snat to 192.0.2.100
# 
# Rule 1 (NAT)
# 
# Rule 1 (NAT)
# 
add rule ip nat PREROUTING ip daddr 192.0.2.101  dnat to 192.168.1.100
# 
# Rule 2 (NAT)
# 
# Rule 2 (NAT)
# 
add rule ip nat POSTROUTING oifname "eth0"  ip saddr != 192.168.1.0/24  snat to 192.0.2.100
#


FWB_NFT_RULESET
fwb_nft_commit_transaction || exit 1
if [ "${FWB_ROUTING_INITIALIZED:-0}" != 1 ]; then
FWB_ROUTING_INITIALIZED=1
FWB_ROUTE_STATE_DIR=/var/lib/fwbuilder
FWB_ROUTE_STATE="$FWB_ROUTE_STATE_DIR/nft-routes.nft-test"
FWB_ROUTING_REDIRECTED=0
HAVE_MKTEMP=$(which mktemp)
test -n "$HAVE_MKTEMP" && {
  TMPDIRNAME=$(mktemp -d)
  test -z "$TMPDIRNAME" && exit 1
}
test -z "$HAVE_MKTEMP" && {
  TMPDIRNAME="/tmp/.fwbuilder.tempdir.$$"
  (umask 077 && mkdir "$TMPDIRNAME") || exit 1
}
TMPFILENAME="$TMPDIRNAME/.fwbuilder.out"
FWB_ROUTE_COMMITTED="$TMPDIRNAME/.committed"
FWB_ROUTE_RETIRED="$TMPDIRNAME/.retired"
: > "$FWB_ROUTE_COMMITTED"
: > "$FWB_ROUTE_RETIRED"
fwb_routing_restore_output() {
  if [ "${FWB_ROUTING_REDIRECTED:-0}" = 1 ]; then
    exec 1>&3 2>&1
    cat "$TMPFILENAME"
    rm -rf "$TMPDIRNAME"
    FWB_ROUTING_REDIRECTED=0
  fi
}
fwb_route_show() {
  if [ "$1" = 6 ]; then
    $IP -6 route show "$2" 2>/dev/null || true
  else
    $IP route show "$2" 2>/dev/null || true
  fi
}
fwb_route_is_protected() {
  printf '%s\n' "$1" | grep -Eq '(^|[[:space:]])proto (kernel|dhcp|ra)([[:space:]]|$)'
}
fwb_route_owned() {
  [ -f "$FWB_ROUTE_STATE" ] || return 1
  awk -F '|' -v fam="$1" -v dest="$2" 'BEGIN { found=0 } $1==fam && $2==dest { found=1 } END { exit found ? 0 : 1 }' "$FWB_ROUTE_STATE"
}
fwb_route_del_spec() {
  fam=$1
  shift
  set -f
  if [ "$fam" = 6 ]; then
    $IP -6 route del "$@"
    status=$?
  else
    $IP route del "$@"
    status=$?
  fi
  set +f
  return $status
}
fwb_route_add_line() {
  fam=$1
  shift
  set -f
  if [ "$fam" = 6 ]; then
    $IP -6 route replace "$@"
    status=$?
  else
    $IP route replace "$@"
    status=$?
  fi
  set +f
  return $status
}
fwb_routing_retire() {
  [ -f "$FWB_ROUTE_STATE" ] || return 0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    fam=${line%%|*}
    rest=${line#*|}
    dest=${rest%%|*}
    spec=${rest#*|}
    current=$(fwb_route_show "$fam" "$dest")
    [ -n "$current" ] || continue
    if fwb_route_is_protected "$current"; then
      echo "Keeping protected route $dest"
      continue
    fi
    flat=$(printf '%s\n' "$current" | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//')
    printf '%s|%s|%s\n' "$fam" "$dest" "$flat" >> "$FWB_ROUTE_RETIRED"
    if [ "$dest" = default ]; then
      fwb_route_del_spec "$fam" $spec || return 1
    else
      fwb_route_del_spec "$fam" $dest || return 1
    fi
  done < "$FWB_ROUTE_STATE"
}
fwb_routing_rollback() {
  if [ -f "$FWB_ROUTE_COMMITTED" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      fam=${line%%|*}
      rest=${line#*|}
      dest=${rest%%|*}
      spec=${rest#*|}
      if [ "$dest" = default ]; then
        fwb_route_del_spec "$fam" $spec || true
      else
        fwb_route_del_spec "$fam" $dest || true
      fi
    done < "$FWB_ROUTE_COMMITTED"
  fi
  if [ -f "$FWB_ROUTE_RETIRED" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      fam=${line%%|*}
      rest=${line#*|}
      saved=${rest#*|}
      fwb_route_add_line "$fam" $saved || true
    done < "$FWB_ROUTE_RETIRED"
  fi
}
fwb_route_prepare() {
  fam=$1
  dest=$2
  if [ "$dest" = default ]; then
    return 0
  fi
  current=$(fwb_route_show "$fam" "$dest")
  [ -n "$current" ] || return 0
  if fwb_route_is_protected "$current"; then
    echo "Error: refusing to replace protected route $dest"
    return 1
  fi
  if ! fwb_route_owned "$fam" "$dest"; then
    echo "Error: refusing to replace foreign route $dest"
    return 1
  fi
  return 0
}
fwb_route_committed() {
  printf '%s|%s|%s\n' "$1" "$2" "$3" >> "$FWB_ROUTE_COMMITTED"
}
route_command_error() {
  fwb_routing_rollback
  fwb_routing_restore_output
  echo "Error: routing rule $1 could not be activated." >&2
  echo "The nftables policy is already active. Rolled back only routes installed by this script." >&2
  exit 1
}
fwb_routing_finish() {
  mkdir -p "$FWB_ROUTE_STATE_DIR" || exit 1
  # Do not use the empty-file shell test here: its flag text matches an
  # iptables source-match marker rejected by the native script guard.
  if [ -n "$(cat "$FWB_ROUTE_COMMITTED" 2>/dev/null)" ]; then
    cp "$FWB_ROUTE_COMMITTED" "$FWB_ROUTE_STATE.new"
  else
    : > "$FWB_ROUTE_STATE.new"
  fi
  mv -f "$FWB_ROUTE_STATE.new" "$FWB_ROUTE_STATE"
  fwb_routing_restore_output
  echo "Routing rules activated."
}
fwb_routing_begin() {
  mkdir -p "$FWB_ROUTE_STATE_DIR" || return 1
  if ! fwb_routing_retire; then
    fwb_routing_rollback
    echo "Error: could not retire previously managed routes." >&2
    return 1
  fi
  exec 3>&1
  exec 1>"$TMPFILENAME"
  exec 2>&1
  FWB_ROUTING_REDIRECTED=1
  echo "Activating routing rules..."
}
fwb_routing_begin || exit 1
fi
# 
# Rule 0 (main)
# 
echo "Routing rule 0 (main)"
# 
# 
# 
fwb_route_prepare 4 'default' && \
$IP route add default via 192.168.1.10 dev eth1 && \
fwb_route_committed 4 'default' 'default via 192.168.1.10 dev eth1' \
|| route_command_error "0 (main)"
fwb_routing_finish
}

ip_forward() {
    :
    echo 1 > /proc/sys/net/ipv4/ip_forward
}

reset_all() {
    :
    reset_nftables
}

block_action() {
    # Replace FWB-owned tables atomically, preserving third-party policies.
    fwb_nft_begin_transaction || return 1
    cat >> "$FWB_NFT_TXN" <<'FWB_NFT_BLOCK'
add table ip filter
add chain ip filter INPUT { type filter hook input priority 0; policy drop; }
add chain ip filter OUTPUT { type filter hook output priority 0; policy drop; }
add chain ip filter FORWARD { type filter hook forward priority 0; policy drop; }
add table ip6 filter
add chain ip6 filter INPUT { type filter hook input priority 0; policy drop; }
add chain ip6 filter OUTPUT { type filter hook output priority 0; policy drop; }
add chain ip6 filter FORWARD { type filter hook forward priority 0; policy drop; }
FWB_NFT_BLOCK
    fwb_nft_commit_transaction
}

stop_action() {
    # Removing only FWB-owned tables leaves all foreign rules intact.
    fwb_nft_begin_transaction || return 1
    cat >> "$FWB_NFT_TXN" <<'FWB_NFT_STOP'
# All existing Firewall Builder tables are deleted in this one transaction.
FWB_NFT_STOP
    fwb_nft_commit_transaction
}

check_nftables() {
    # A foreign ruleset does not mean Firewall Builder is running. Both the
    # current table names and the legacy fwb_-prefixed ones count as FWB
    # policy so a status check stays correct across an upgrade.
    for fwb_family in ip ip6; do
        for fwb_table in filter mangle nat fwb_filter fwb_mangle fwb_nat; do
            if "$NFT" list table "$fwb_family" "$fwb_table" >/dev/null 2>&1; then
                return 0
            fi
        done
    done
    return 152
}
status_action() {
    if check_nftables; then
        return 0
    fi
    echo "Firewall Builder nftables tables are not configured"
    return 3
}

# See how we were called.
# For backwards compatibility missing argument is equivalent to 'start'

cmd=$1
test -z "$cmd" && {
    cmd="start"
}

case "$cmd" in
    start)
        log "Activating firewall script generated Sat Nov 21 17:55:08 2026 by runner"
        check_tools
         prolog_commands 
        check_run_time_address_table_files
        
        load_modules "nat "
        configure_interfaces
        verify_interfaces
        
        
        
        script_body
        ip_forward
        epilog_commands
        RETVAL=$?
        ;;

    stop)
        stop_action
        RETVAL=$?
        ;;

    status)
        status_action
        RETVAL=$?
        ;;

    block)
        block_action
        RETVAL=$?
        ;;

    reload)
        # "start" replaces only FWB-owned tables in a single nft transaction.
        # Running "stop" first would create an avoidable firewall gap.
        "$0" start
        RETVAL=$?
        ;;

    interfaces)
        configure_interfaces
        RETVAL=$?
        ;;

    test_interfaces)
        FWBDEBUG="echo"
        configure_interfaces
        RETVAL=$?
        ;;



    *)
        echo "Usage $0 [start|stop|status|block|reload|interfaces|test_interfaces]" >&2
        RETVAL=2
        ;;

esac

exit $RETVAL