## -*- mode: shell-script; -*-
## Native nftables routing activation.
## Declares, installs and rolls back only routes this script owns.
## Kernel, DHCP and RA routes are left in place. Routing tables are
## never flushed. Routes compiled from a rule set with a named
## iproute2 table always carry the "table <name>" keyword; the main
## table keeps the historical keyword-less commands.
##
## {{$firewall_name}} is the firewall object name, restricted to a
## safe state-file suffix by the compiler.
##
if [ "${FWB_ROUTING_INITIALIZED:-0}" != 1 ]; then
FWB_ROUTING_INITIALIZED=1
FWB_ROUTE_STATE_DIR=/var/lib/fwbuilder
FWB_ROUTE_STATE="$FWB_ROUTE_STATE_DIR/nft-routes.{{$firewall_name}}"
FWB_RULE_STATE="$FWB_ROUTE_STATE_DIR/nft-iprules.{{$firewall_name}}"
## The firewall option adopt_foreign_routes (default off) lets this
## script take over a route that already exists but was not installed
## by a script of this firewall (e.g. a static route OpenWrt netifd
## re-creates at boot). Protected kernel, DHCP and RA routes are never
## adopted, no matter what this option says.
FWB_ROUTE_ADOPT={{$route_adopt_foreign}}
FWB_ROUTING_REDIRECTED=0
HAVE_MKTEMP=$(which mktemp)
test -n "$HAVE_MKTEMP" && {
  TMPDIRNAME=$(mktemp -d)
  test -z "$TMPDIRNAME" && exit 1
}
test -z "$HAVE_MKTEMP" && {
  TMPDIRNAME="/tmp/.fwbuilder.tempdir.$$"
  (umask 077 && mkdir "$TMPDIRNAME") || exit 1
}
TMPFILENAME="$TMPDIRNAME/.fwbuilder.out"
FWB_ROUTE_COMMITTED="$TMPDIRNAME/.committed"
FWB_ROUTE_RETIRED="$TMPDIRNAME/.retired"
FWB_RULE_COMMITTED="$TMPDIRNAME/.iprules-committed"
FWB_RULE_RETIRED="$TMPDIRNAME/.iprules-retired"
: > "$FWB_ROUTE_COMMITTED"
: > "$FWB_ROUTE_RETIRED"
: > "$FWB_RULE_COMMITTED"
: > "$FWB_RULE_RETIRED"
fwb_routing_restore_output() {
  if [ "${FWB_ROUTING_REDIRECTED:-0}" = 1 ]; then
    exec 1>&3 2>&1
    cat "$TMPFILENAME"
    rm -rf "$TMPDIRNAME"
    FWB_ROUTING_REDIRECTED=0
  fi
}
# State entries are "family|table|destination|spec". Entries written
# by scripts generated before named tables existed have three fields
# and always name the main table.
fwb_route_state_fields() {
  # Splits $1 into FWB_STATE_FAM, FWB_STATE_TABLE, FWB_STATE_DEST,
  # FWB_STATE_SPEC. Route specifications never contain "|".
  set -f
  IFS='|'
  set -- $1
  IFS=' 	
'
  set +f
  FWB_STATE_FAM=$1
  if [ $# -ge 4 ]; then
    FWB_STATE_TABLE=$2
    FWB_STATE_DEST=$3
    FWB_STATE_SPEC=$4
  else
    FWB_STATE_TABLE=main
    FWB_STATE_DEST=$2
    FWB_STATE_SPEC=$3
  fi
}
fwb_route_show() {
  if [ "$1" = 6 ]; then
    if [ "$2" = main ]; then
      $IP -6 route show "$3" 2>/dev/null || true
    else
      $IP -6 route show table "$2" "$3" 2>/dev/null || true
    fi
  else
    if [ "$2" = main ]; then
      $IP route show "$3" 2>/dev/null || true
    else
      $IP route show table "$2" "$3" 2>/dev/null || true
    fi
  fi
}
fwb_route_is_protected() {
  printf '%s\n' "$1" | grep -Eq '(^|[[:space:]])proto (kernel|dhcp|ra)([[:space:]]|$)'
}
fwb_route_owned() {
  [ -f "$FWB_ROUTE_STATE" ] || return 1
  awk -F '|' -v fam="$1" -v table="$2" -v dest="$3" 'BEGIN { found=0 }
    NF == 3 { if ($1==fam && table=="main" && $2==dest) found=1 }
    NF >= 4 { if ($1==fam && $2==table && $3==dest) found=1 }
    END { exit found ? 0 : 1 }' "$FWB_ROUTE_STATE"
}
fwb_route_del_spec() {
  fam=$1
  table=$2
  shift 2
  set -f
  if [ "$table" = main ]; then
    if [ "$fam" = 6 ]; then
      $IP -6 route del "$@"
    else
      $IP route del "$@"
    fi
  else
    if [ "$fam" = 6 ]; then
      $IP -6 route del "$@" table "$table"
    else
      $IP route del "$@" table "$table"
    fi
  fi
  status=$?
  set +f
  return $status
}
fwb_route_add_line() {
  fam=$1
  table=$2
  shift 2
  set -f
  if [ "$table" = main ]; then
    if [ "$fam" = 6 ]; then
      $IP -6 route replace "$@"
    else
      $IP route replace "$@"
    fi
  else
    if [ "$fam" = 6 ]; then
      $IP -6 route replace "$@" table "$table"
    else
      $IP route replace "$@" table "$table"
    fi
  fi
  status=$?
  set +f
  return $status
}
fwb_routing_retire() {
  [ -f "$FWB_ROUTE_STATE" ] || return 0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    fwb_route_state_fields "$line"
    current=$(fwb_route_show "$FWB_STATE_FAM" "$FWB_STATE_TABLE" "$FWB_STATE_DEST")
    [ -n "$current" ] || continue
    if fwb_route_is_protected "$current"; then
      echo "Keeping protected route $FWB_STATE_DEST"
      continue
    fi
    flat=$(printf '%s\n' "$current" | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//')
    printf '%s|%s|%s|%s\n' "$FWB_STATE_FAM" "$FWB_STATE_TABLE" "$FWB_STATE_DEST" "$flat" >> "$FWB_ROUTE_RETIRED"
    if [ "$FWB_STATE_DEST" = default ]; then
      fwb_route_del_spec "$FWB_STATE_FAM" "$FWB_STATE_TABLE" $FWB_STATE_SPEC || return 1
    else
      fwb_route_del_spec "$FWB_STATE_FAM" "$FWB_STATE_TABLE" "$FWB_STATE_DEST" || return 1
    fi
  done < "$FWB_ROUTE_STATE"
}
fwb_routing_rollback() {
  if [ -f "$FWB_ROUTE_COMMITTED" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      fwb_route_state_fields "$line"
      if [ "$FWB_STATE_DEST" = default ]; then
        fwb_route_del_spec "$FWB_STATE_FAM" "$FWB_STATE_TABLE" $FWB_STATE_SPEC || true
      else
        fwb_route_del_spec "$FWB_STATE_FAM" "$FWB_STATE_TABLE" "$FWB_STATE_DEST" || true
      fi
    done < "$FWB_ROUTE_COMMITTED"
  fi
  if [ -f "$FWB_ROUTE_RETIRED" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      fwb_route_state_fields "$line"
      fwb_route_add_line "$FWB_STATE_FAM" "$FWB_STATE_TABLE" $FWB_STATE_SPEC || true
    done < "$FWB_ROUTE_RETIRED"
  fi
  if [ -f "$FWB_RULE_COMMITTED" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      fwb_rule_state_fields "$line"
      fwb_rule_del_state "$FWB_RULE_STATE_FAM" "$FWB_RULE_STATE_PRIO" "$FWB_RULE_STATE_SPEC" || true
    done < "$FWB_RULE_COMMITTED"
  fi
  if [ -f "$FWB_RULE_RETIRED" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      fwb_rule_state_fields "$line"
      fwb_rule_add_state "$FWB_RULE_STATE_FAM" "$FWB_RULE_STATE_PRIO" "$FWB_RULE_STATE_SPEC" || true
    done < "$FWB_RULE_RETIRED"
  fi
}
fwb_route_prepare() {
  fam=$1
  table=$2
  dest=$3
  if [ "$dest" = default ]; then
    return 0
  fi
  current=$(fwb_route_show "$fam" "$table" "$dest")
  [ -n "$current" ] || return 0
  if fwb_route_is_protected "$current"; then
    echo "Error: refusing to replace protected route $dest"
    return 1
  fi
  if ! fwb_route_owned "$fam" "$table" "$dest"; then
    if [ "$FWB_ROUTE_ADOPT" = 1 ]; then
      # Adopt: the route exists but no script of this firewall
      # installed it. Record its current spec so the rollback can
      # restore it, delete it and let the compiled route take over.
      flat=$(printf '%s\n' "$current" | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//')
      printf '%s|%s|%s|%s\n' "$fam" "$table" "$dest" "$flat" >> "$FWB_ROUTE_RETIRED"
      fwb_route_del_spec "$fam" "$table" "$dest" || return 1
      echo "Adopting foreign route $dest"
      return 0
    fi
    echo "Error: refusing to replace foreign route $dest"
    echo "The route exists but was not installed by this script. Remove it at its origin or set firewall option adopt_foreign_routes to take it over."
    return 1
  fi
  return 0
}
fwb_route_committed() {
  printf '%s|%s|%s|%s\n' "$1" "$2" "$3" "$4" >> "$FWB_ROUTE_COMMITTED"
}
# Rule state entries are "family|priority|spec". Unlike routes, the
# kernel accumulates multiple ip rules at the same priority silently,
# so every helper deletes by the exact priority plus specification.
fwb_rule_state_fields() {
  # Splits $1 into FWB_RULE_STATE_FAM, FWB_RULE_STATE_PRIO,
  # FWB_RULE_STATE_SPEC. Ip rule specifications never contain "|".
  set -f
  IFS='|'
  set -- $1
  IFS=' 	
'
  set +f
  FWB_RULE_STATE_FAM=$1
  FWB_RULE_STATE_PRIO=$2
  FWB_RULE_STATE_SPEC=$3
}
fwb_rule_del_state() {
  fam=$1
  prio=$2
  spec=$3
  set -f
  if [ "$fam" = 6 ]; then
    $IP -6 rule del pref "$prio" $spec
  else
    $IP rule del pref "$prio" $spec
  fi
  status=$?
  set +f
  return $status
}
fwb_rule_add_state() {
  fam=$1
  prio=$2
  spec=$3
  set -f
  if [ "$fam" = 6 ]; then
    $IP -6 rule add pref "$prio" $spec
  else
    $IP rule add pref "$prio" $spec
  fi
  status=$?
  set +f
  return $status
}
fwb_rule_del_pref() {
  set -f
  if [ "$1" = 6 ]; then
    $IP -6 rule del pref "$2"
  else
    $IP rule del pref "$2"
  fi
  status=$?
  set +f
  return $status
}
fwb_rule_has_priority() {
  if [ "$1" = 6 ]; then
    $IP -6 rule list 2>/dev/null || true
  else
    $IP rule list 2>/dev/null || true
  fi | grep -Eq "^[[:space:]]*$2:"
}
fwb_rules_retire() {
  [ -f "$FWB_RULE_STATE" ] || return 0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    fwb_rule_state_fields "$line"
    # An outdated rule may already be gone; never fail the
    # activation for that.
    fwb_rule_del_state "$FWB_RULE_STATE_FAM" "$FWB_RULE_STATE_PRIO" "$FWB_RULE_STATE_SPEC" || true
    printf '%s|%s|%s\n' "$FWB_RULE_STATE_FAM" "$FWB_RULE_STATE_PRIO" "$FWB_RULE_STATE_SPEC" >> "$FWB_RULE_RETIRED"
  done < "$FWB_RULE_STATE"
}
fwb_rule_prepare() {
  # $1 family, $2 priority, $3 plain specification
  fam=$1
  prio=$2
  spec=$3
  # Self-inflicted duplicates: adding the identical rule again would
  # create a silent twin at the same priority.
  fwb_rule_del_state "$fam" "$prio" "$spec" || true
  if [ "${FWB_RULE_REPLACE:-0}" = 1 ]; then
    # Replace strategy: flush every rule at this priority, ours were
    # already retired above, the rest is foreign.
    n=0
    while fwb_rule_del_pref "$fam" "$prio" 2>/dev/null && [ "$n" -lt 64 ]; do
      n=$((n+1))
    done
    return 0
  fi
  if fwb_rule_has_priority "$fam" "$prio"; then
    echo "Error: refusing to add ip rule at priority $prio: the priority is already in use"
    return 1
  fi
  return 0
}
fwb_rule_committed() {
  printf '%s|%s|%s\n' "$1" "$2" "$3" >> "$FWB_RULE_COMMITTED"
}
fwb_rt_tables_ensure() {
  fwb_table_name=$1
  fwb_table_id=$2
  fwb_rt_tables=/etc/iproute2/rt_tables
  # Do not use the empty-file shell test here: its flag text matches an
  # iptables source-match marker rejected by the native script guard.
  if [ ! -f "$fwb_rt_tables" ] || [ -z "$(cat "$fwb_rt_tables" 2>/dev/null)" ]; then
    echo "Error: $fwb_rt_tables does not exist or is empty"
    return 1
  fi
  if grep -Eq "^[[:space:]]*$fwb_table_id[[:space:]]+$fwb_table_name([[:space:]]|$)" "$fwb_rt_tables"; then
    return 0
  fi
  if grep -Eq "^[[:space:]]*[0-9]+[[:space:]]+$fwb_table_name([[:space:]]|$)" "$fwb_rt_tables"; then
    echo "Error: routing table name $fwb_table_name already has a different number in $fwb_rt_tables"
    return 1
  fi
  if grep -Eq "^[[:space:]]*$fwb_table_id[[:space:]]" "$fwb_rt_tables"; then
    echo "Error: routing table number $fwb_table_id is already used by another name in $fwb_rt_tables"
    return 1
  fi
  if ! printf '%s\t%s\n' "$fwb_table_id" "$fwb_table_name" >> "$fwb_rt_tables"; then
    echo "Error: cannot append routing table $fwb_table_name to $fwb_rt_tables"
    return 1
  fi
  echo "Added routing table $fwb_table_name ($fwb_table_id) to $fwb_rt_tables"
}
route_command_error() {
  fwb_routing_rollback
  fwb_routing_restore_output
  echo "Error: routing rule $1 could not be activated." >&2
  echo "The nftables policy is already active. Rolled back only routes installed by this script." >&2
  exit 1
}
fwb_routing_finish() {
  mkdir -p "$FWB_ROUTE_STATE_DIR" || exit 1
  # Do not use the empty-file shell test here: its flag text matches an
  # iptables source-match marker rejected by the native script guard.
  if [ -n "$(cat "$FWB_ROUTE_COMMITTED" 2>/dev/null)" ]; then
    cp "$FWB_ROUTE_COMMITTED" "$FWB_ROUTE_STATE.new"
  else
    : > "$FWB_ROUTE_STATE.new"
  fi
  mv -f "$FWB_ROUTE_STATE.new" "$FWB_ROUTE_STATE"
  if [ -n "$(cat "$FWB_RULE_COMMITTED" 2>/dev/null)" ]; then
    cp "$FWB_RULE_COMMITTED" "$FWB_RULE_STATE.new"
  else
    : > "$FWB_RULE_STATE.new"
  fi
  mv -f "$FWB_RULE_STATE.new" "$FWB_RULE_STATE"
  fwb_routing_restore_output
  echo "Routing rules activated."
}
fwb_routing_begin() {
  mkdir -p "$FWB_ROUTE_STATE_DIR" || return 1
  if ! fwb_routing_retire; then
    fwb_routing_rollback
    echo "Error: could not retire previously managed routes." >&2
    return 1
  fi
  # Previous-generation ip rules of this firewall are retired with the
  # same lookup-by-state approach as routes. A missing state file
  # (first activation or reboot) simply means nothing to retire.
  fwb_rules_retire
  exec 3>&1
  exec 1>"$TMPFILENAME"
  exec 2>&1
  FWB_ROUTING_REDIRECTED=1
  echo "Activating routing rules..."
}
fwb_routing_begin || exit 1
fi
