## -*- mode: shell-script; -*-
##
## To be able to make changes to the part of configuration created
## from this configlet you need to copy this file to the directory
## fwbuilder/configlets/nftables/ in your home directory and modify it.
## Double "##" comments are removed during processing but single "#"
## comments are be retained and appear in the generated script. Empty
## lines are removed as well.
##
## Configlets support simple macro language with these constructs:
## {{$var}} is variable expansion
## {{if var}} is conditional operator.
##
## This configlet defines commands executed when nftables script is ran
## with command line argument "block". The FWB-owned tables and their
## base chains are declared by fwb_nft_declare_base_chains() so the
## emergency policy and the normal activation always agree about the
## table and chain layout.

block_action() {
    # Replace FWB-owned tables atomically, preserving third-party policies.
    fwb_nft_begin_transaction || return 1
    fwb_nft_declare_base_chains block || return 1
    cat >> "$FWB_NFT_TXN" <<'FWB_NFT_BLOCK'
# Emergency management access rules for the backup ssh access option.
{{if mgmt_access_ipv4}}
add rule ip filter INPUT ip saddr {{$ssh_management_address_ipv4}} tcp dport 22 ct state { new, established } accept
add rule ip filter OUTPUT ip daddr {{$ssh_management_address_ipv4}} tcp sport 22 ct state { established, related } accept
{{endif}}
{{if mgmt_access_ipv6}}
add rule ip6 filter INPUT ip6 saddr {{$ssh_management_address_ipv6}} tcp dport 22 ct state { new, established } accept
add rule ip6 filter OUTPUT ip6 daddr {{$ssh_management_address_ipv6}} tcp sport 22 ct state { established, related } accept
{{endif}}
FWB_NFT_BLOCK
    fwb_nft_commit_transaction
}
